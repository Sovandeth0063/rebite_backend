# Server Port
PORT=5000

# PostgreSQL Connection Configuration (Postgres is running on port 3000)
DATABASE_URL=postgresql://postgres:postgres@localhost:3000/rescuebite

# Alternative individual config (if DATABASE_URL is omitted)
PGHOST=localhost
PGPORT=3000
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=rescuebite

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:3001

# Google Gemini API Key for AI Assistant & Translation (optional)
GEMINI_API_KEY=""
